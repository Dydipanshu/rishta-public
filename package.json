{
  "name": "rishta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seedDemo.ts",
    "test": "vitest run",
    "eval": "tsx eval/runEvals.ts",
    "spike:check": "tsx scripts/spike/checkKeys.ts",
    "spike:openai": "tsx scripts/spike/openaiSmoke.ts",
    "spike:tts": "tsx scripts/spike/ttsVoices.ts",
    "spike:stt": "tsx scripts/spike/sttClips.ts",
    "spike:latency": "tsx scripts/spike/latency.ts",
    "spike:ttsspeed": "tsx scripts/spike/ttsSpeed.ts",
    "dev": "concurrently -k -n api,web \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "reset": "tsx scripts/resetDemo.ts",
    "typecheck:web": "tsc --noEmit -p web",
    "daily": "tsx src/worker/daily.ts",
    "contracts": "tsx scripts/writeContracts.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@embedded-postgres/linux-x64",
      "embedded-postgres"
    ]
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@prometheus-io/client": "^0.16.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "kafkajs": "^2.2.4",
    "openai": "^7.45.1",
    "pg": "^8.23.1",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sarvamai": "^1.1.14",
    "seedrandom": "^3.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/seedrandom": "^3.0.8",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "embedded-postgres": "17.5.0-beta.15",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
