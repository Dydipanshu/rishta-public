{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "const": "outreach.requested"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "at": {
      "type": "string"
    },
    "merchantId": {
      "type": "string"
    },
    "briefId": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "at",
    "merchantId",
    "briefId",
    "channel"
  ]
}
