{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "briefId": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "stayed",
        "plan_changed",
        "ticket_raised",
        "fix_confirmed",
        "handed_off",
        "return_requested",
        "later",
        "undecided",
        "opted_out",
        "left",
        "no_response"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "fee_confusion",
              "settlement_delay",
              "device_fault",
              "rent_too_high",
              "rival_offer",
              "low_sales_season",
              "support_unresolved",
              "closing_business",
              "other",
              "unknown"
            ]
          },
          "quote": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "quote"
        ]
      }
    },
    "actionsTaken": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "getMerchantSummary",
          "explainFee",
          "checkDeviceHealth",
          "raiseTicket",
          "proposePlan",
          "changePlan",
          "scheduleHumanCallback",
          "recordOutcome",
          "recordOptOut",
          "sendAppMessage",
          "requestDeviceReturn",
          "confirmFix"
        ]
      }
    },
    "durationSec": {
      "type": "number"
    },
    "numbersVerified": {
      "type": "boolean"
    },
    "numbersChecked": {
      "default": 0,
      "type": "number"
    },
    "summary": {
      "type": "string"
    },
    "handledBy": {
      "default": "ai",
      "type": "string",
      "enum": [
        "ai",
        "human"
      ]
    }
  },
  "required": [
    "briefId",
    "outcome",
    "reasons",
    "actionsTaken",
    "durationSec",
    "numbersVerified",
    "summary"
  ]
}
