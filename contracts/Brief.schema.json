{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "briefId": {
      "type": "string"
    },
    "merchantId": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "soundbox",
        "app",
        "salesperson_visit",
        "human_callback",
        "inbound"
      ]
    },
    "problem": {
      "type": "string",
      "enum": [
        "fee_confusion",
        "settlement_delay",
        "device_fault",
        "rent_too_high",
        "rival_offer",
        "low_sales_season",
        "support_unresolved",
        "closing_business",
        "loan_overdue",
        "loan_opportunity",
        "other",
        "unknown"
      ]
    },
    "approachId": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "facts": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "number",
          "string"
        ]
      }
    },
    "allowedActions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "getMerchantSummary",
          "getShopProfile",
          "explainFee",
          "checkDeviceHealth",
          "raiseTicket",
          "proposePlan",
          "changePlan",
          "scheduleHumanCallback",
          "recordOutcome",
          "recordOptOut",
          "sendAppMessage",
          "requestDeviceReturn",
          "confirmFix",
          "checkLoan",
          "setReducedEmi",
          "proposeLoan",
          "acceptLoan"
        ]
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxDiscountInr": {
          "type": "number"
        }
      },
      "required": [
        "maxDiscountInr"
      ]
    },
    "mustSay": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mustNot": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "escalateIf": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "successCriteria": {
      "type": "string"
    }
  },
  "required": [
    "briefId",
    "merchantId",
    "displayName",
    "language",
    "channel",
    "problem",
    "approachId",
    "goal",
    "facts",
    "allowedActions",
    "limits",
    "mustSay",
    "mustNot",
    "escalateIf",
    "successCriteria"
  ]
}
